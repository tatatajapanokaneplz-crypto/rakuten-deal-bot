# Gemini API(投稿文の「表現部分」の生成に使用)
GEMINI_API_KEY=

# 楽天ウェブサービス(https://webservice.rakuten.co.jp/)で開発者登録して発行
RAKUTEN_APP_ID=

# 2026年5月の新API移行で追加必須になったアクセスキー(開発者コンソールで発行)
RAKUTEN_ACCESS_KEY=

# アプリ登録時の「許可Webサイト(Allowed websites)」欄に入力した値と完全一致させること
# 実在サイトでなくてよい。Origin/Refererヘッダーとして送信される
RAKUTEN_ALLOWED_SITE=https://rakuten-granpa.example

# 楽天アフィリエイト管理画面で発行される、あなたのアフィリエイトID
RAKUTEN_AFFILIATE_ID=

# Bufferダッシュボード(https://publish.buffer.com/settings/api)で発行する個人APIキー
# ※旧REST APIの開発者登録は停止済み。GraphQL API用の個人APIキーを使う
BUFFER_ACCESS_TOKEN=

# 組織ID。初回のみ BufferClient().get_organization_id() で取得し、ここに固定保存する
BUFFER_ORGANIZATION_ID=

# Bufferダッシュボードで接続したチャンネルのID
# (BufferClient().list_channels() で確認。X/Threadsそれぞれ別アカウントとして接続する)
BUFFER_CHANNEL_ID_X=
BUFFER_CHANNEL_ID_THREADS=

# healthchecks.io 等の外部デッドマンズスイッチサービスで発行するping用URL
# トラックごとに分けることで、どちらが止まったか判別できるようにする
HEALTHCHECK_URL_TIMESALE=
HEALTHCHECK_URL_RANKING=

# 通知先(異常検知時のみ通知する。Discord Webhook URL等)
NOTIFY_WEBHOOK_URL=
